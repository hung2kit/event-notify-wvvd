# PostgreSQL. Host port 5433 avoids a Postgres already bound to 5432.
# Inside Docker Compose the host name is `postgres` and the port stays 5432.
DATABASE_URL=postgres://phattin:phattin@localhost:5433/phattin

# All schedule math uses this zone. Stored instants are UTC.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# entra = Microsoft Entra ID SSO (phase 5). dev = sign in as the seeded user.
AUTH_MODE=dev
DEV_USER_EMAIL=son_le_quoc_hung@wvi.org

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# graph = Microsoft Graph sendMail. smtp = nodemailer.
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Event Notify
# true puts group addresses in Bcc instead of To.
MAIL_USE_BCC=false

# Local Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_SECURE=false SMTP_REQUIRE_TLS=false
# Outlook STARTTLS: host smtp-mail.outlook.com, port 587, SMTP_SECURE=false, SMTP_REQUIRE_TLS=true.
# Put the real username and password only in .env. That file is gitignored.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=

# Occurrences later than this are marked skipped ("missed while offline") instead of sent.
MISSED_SEND_GRACE_MINUTES=60
# pg-boss cron tick. Must be a divisor of 60.
SCHEDULER_INTERVAL_SECONDS=30

# Browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173

# Process settings (not product secrets).
API_PORT=3000
LOG_LEVEL=info
# Local Docker sets this true so the demo groups and announcements load on boot.
# Leave false in any shared environment so a restart cannot overwrite schedules.
SEED_ON_BOOT=false

# Server only (docker-compose.prod.yml). The database password is required there.
POSTGRES_PASSWORD=
# Port the web app listens on. Defaults to 8080.
WEB_PORT=8080
